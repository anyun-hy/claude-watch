<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>@CW_ENTRY_DISPLAY_NAME@</string>
    <key>CFBundleExecutable</key>
    <string>ControlledEntryApp</string>
    <key>CFBundleIdentifier</key>
    <string>io.local.watchpanel.entry.@CW_ENTRY_TARGET_ID@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>@CW_ENTRY_DISPLAY_NAME@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@CW_VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@CW_VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>CWManagedEntryTarget</key>
    <string>@CW_ENTRY_TARGET_ID@</string>
    <key>CWWatchBinaryPath</key>
    <string>@CW_WATCH_BINARY_PATH@</string>
</dict>
</plist>

